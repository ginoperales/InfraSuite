{
  "name": "infra-admin",
  "private": true,
  "version": "1.0.1",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "npm-run-all --parallel dev electron:start-watch",
    "electron:start-watch": "tsc -w -p electron/tsconfig.json & electron .",
    "electron:build": "tsc -p electron/tsconfig.json && npm run build && electron-builder"
  },
  "build": {
    "appId": "com.infrasuite.app",
    "productName": "InfraSuite",
    "electronVersion": "43.3.0",
    "directories": {
      "output": "release"
    },
    "protocols": [
      {
        "name": "InfraSuite",
        "schemes": [
          "infrasuite"
        ]
      }
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "publish": {
      "provider": "generic",
      "url": "https://infrasuitee.web.app/installer/"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@infrasuite/auth": "*",
    "@infrasuite/firebase": "*",
    "@infrasuite/license-service": "*",
    "@infrasuite/permissions": "*",
    "@infrasuite/shared": "*",
    "@infrasuite/sqlite": "*",
    "@infrasuite/sync-service": "*",
    "@splinetool/react-spline": "^4.1.0",
    "@supabase/supabase-js": "^2.112.2",
    "animejs": "^4.4.1",
    "better-sqlite3": "^13.0.3",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "firebase": "^12.15.0",
    "framer-motion": "^12.40.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.28.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "three": "^0.184.0",
    "xlsx": "^0.18.5",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/animejs": "^3.1.13",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "npm-run-all": "^4.1.5",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
